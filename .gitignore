# ── Private data (usernames) — never commit ───────────────────────────────────
# Exported CSVs with usernames, the username <-> ID key, and the username
# version of the user table (written by 1_data_prep.R, 1b and 3)
input_data_from_python/*
!input_data_from_python/.gitkeep

# Prepped .rds files with usernames (1_data_prep.R)
prepped_data/*
!prepped_data/.gitkeep

# Belt and braces: the private key, wherever it ends up
**/PRIVATE_*

# Shareable data (input_data_anonymized/, prepped_data_anonymized/) IS committed.
# GitHub rejects files over 100 MB: check the .rds sizes before pushing.

# Embedding cache from 5_topics.py (large; rebuilt automatically)
prepped_data_anonymized/topic_embeddings/

# Keep the folder structure itself
!**/.gitkeep

# ── Secrets and environments ─────────────────────────────────────────────────
.env
.venv/

# ── Python cruft ─────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.ipynb_checkpoints/

# ── R session / project cruft ────────────────────────────────────────────────
.Rproj.user/
.Rhistory
.RData
.RDataTmp
.Ruserdata
*.Rproj.bak

# renv library (if used later) — keep the lockfile, ignore the library
renv/library/
renv/staging/

# ── Outputs ──────────────────────────────────────────────────────────────────
# Final tables and figures ARE committed so the repo is browsable;
# only scratch files are ignored.
graphical_output/**/*.tmp
*.log

# ── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
*~
~$*

# ── LaTeX build artifacts (Overleaf sync) ────────────────────────────────────
*.aux
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg